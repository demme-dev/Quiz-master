<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuizeApp">

        <!-- Launcher Activity -->
        <activity
            android:name=".ui.WelcomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.QuizeApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings Activity -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:theme="@style/Theme.QuizeApp" />

        <!-- Category Selection Activity -->
        <activity
            android:name=".ui.CategoryActivity"
            android:exported="false"
            android:label="@string/select_category_title"
            android:theme="@style/Theme.QuizeApp" />

        <!-- Quiz Activity -->
        <activity
            android:name=".ui.QuizActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.QuizeApp" />

        <!-- Results Activity -->
        <activity
            android:name=".ui.ResultActivity"
            android:exported="false"
            android:label="@string/quiz_completed"
            android:theme="@style/Theme.QuizeApp" />

        <!-- Answer Review Activity -->
        <activity
            android:name=".ui.ReviewActivity"
            android:exported="false"
            android:label="@string/review_title"
            android:theme="@style/Theme.QuizeApp" />

        <!-- Legacy MainActivity preserved for backwards compatibility -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.QuizeApp" />
    </application>

</manifest>
